{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unify-control.local/schemas/adapter-manifest-1.json",
  "title": "UNIFY CONTROL declarative adapter manifest",
  "description": "Data-only adapter declaration. This schema does not authorize executable code or hardware writes.",
  "type": "object",
  "required": ["id", "version", "vendor", "model", "vid", "pid", "evidenceUri", "transport", "operations"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "vendor": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "vid": {"type": "integer", "minimum": 1, "maximum": 65535},
    "pid": {"type": "integer", "minimum": 1, "maximum": 65535},
    "revision": {"type": "integer", "minimum": 1, "maximum": 65535},
    "minimumFirmware": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,7}$"},
    "maximumFirmware": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,7}$"},
    "evidenceUri": {"type": "string", "format": "uri", "pattern": "^https://[^ /?#@]+"},
    "transport": {"enum": ["HidFeature", "HidOutput", "VendorControl", "VendorBulk", "UsbWinUsb", "BleGatt"]},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "required": ["capability", "kind", "minimum", "maximum"],
        "properties": {
          "capability": {"enum": ["DPI", "DPI_XY", "POLLING_RATE", "LIFT_OFF_DISTANCE", "ANGLE_SNAPPING", "MOTION_SYNC", "RIPPLE_CONTROL", "DEBOUNCE_TIME", "BUTTON_REMAP", "SCROLL_SETTINGS", "KEY_REMAP", "RAPID_TRIGGER", "ADJUSTABLE_ACTUATION", "SOCD", "DKS", "SNAP_TAP", "RGB", "RGB_BRIGHTNESS", "PROFILE_SWITCH", "BATTERY_LEVEL"]},
          "kind": {"enum": ["Read", "Write"]},
          "minimum": {"type": "integer"},
          "maximum": {"type": "integer"},
          "unit": {"type": "string", "maxLength": 24},
          "requiresReadback": {"type": "boolean"},
          "reversible": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
